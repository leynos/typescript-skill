{
  "gitignore": true,
  "config": {
    "MD004": { "style": "dash" },
    "MD010": { "code_blocks": false },
    "MD013": {
      "line_length": 80,
      "code_block_line_length": 120,
      "tables": false,
      "headings": false
    },
    "MD024": { "siblings_only": true },
    "MD029": { "style": "ordered" }
  },
  "ignores": [
    "skills/effect-v4/references/upstream/**",
    "skills/effect-v4/references/renames/**",
    "**/.venv/**",
    ".vtcode/**",
    "**/node_modules/**",
    "**/target/**",
    ".terraform/**",
    ".uv-cache/**",
    "memories/**",
    "CRUSH.md"
  ]
}
