{
  // The example gate compiles under the pinned TypeScript 7 release. TypeScript
  // 7 defaults to strict mode, `module: esnext`, and `types: []`; the options
  // below only tighten further so the fixtures model the sharpest supported
  // greenfield posture. Brownfield postures are discussed in the skills, not
  // modelled here.
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "erasableSyntaxOnly": true,
    "module": "nodenext",
    "target": "es2024",
    "lib": ["es2024", "dom", "webworker"],
    "types": [],
    "noEmit": true,
    "skipLibCheck": true,
    "rootDir": "."
  },
  "include": ["positive/**/*.ts", "diagnostics/**/*.ts"]
}
